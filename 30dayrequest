const months = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']; // define month abbreviations

function getBucketId(timestamp) {
  const date = new Date(timestamp);
  return `${months[date.getMonth()]}${date.getFullYear()}`;
}

function getBucketsInRange(startTimestamp, endTimestamp) {
  let buckets = [];
  const startDate = new Date(parseInt(startTimestamp));
  const endDate = new Date(parseInt(endTimestamp));

  console.log("date range", startDate, endDate);

  let current = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
  while (current <= endDate) {
    buckets.push(getBucketId(current.getTime()));
    current.setMonth(current.getMonth() + 1);
  }
  return buckets;
}

function getUserLogsRecursive(uid, buckets, logss, response, startTimestamp, endTimestamp) {
  let month = buckets.shift();

  firestore.collection(`tracking_month__${month}`)
    .where("uid", "==", uid)
    .get()
    .then((snapshot) => {
      snapshot.forEach((doc) => {
        const docData = doc.data();
        if (
          docData.timestamp >= parseInt(startTimestamp) &&
          docData.timestamp <= parseInt(endTimestamp)
        ) {
          logss.push(docData); // manually filter by timestamp
        }
      });

      if (buckets.length > 0) {
        getUserLogsRecursive(uid, buckets, logss, response, startTimestamp, endTimestamp);
      } else {
        console.log(logss);
        //response.send(logss);
      }
    })
    .catch((error) => {
      console.log(error);
      response.send({});
    });
}

function getUserLogsRecursive30day(buckets, logss, startTimestamp, endTimestamp) {
  if (buckets.length === 0) {
    return Promise.resolve(logss);
  }
  let month = buckets.shift();

  return firestore
    //.collection(`tracking_month__${month}`)
    .collection(`tracking_category__session_events`)
    .get()
    .then((snapshot) => {
      snapshot.forEach((doc) => {
        const docData = doc.data();
        if (
          docData.timestamp >= parseInt(startTimestamp) &&
          docData.timestamp <= parseInt(endTimestamp) &&
          docData.event === 'app.opened' || 'app.broughtToForeground'
        ) {
          logss.push(docData); // manually filter by timestamp
        }
      });

      if (buckets.length > 0) {
        return getUserLogsRecursive30day(buckets, logss, startTimestamp, endTimestamp);
      } else {
        return logss;
        //response.send(logss);
      }
    })
    .catch((error) => {
      console.log(error);
      return logss;
    });
}







exports.getLogsForUserInDaterange = onRequest((request, response) => {
  console.log(request.body);
  const { uid, startTimestamp, endTimestamp } = request.body;

  if (!uid || !startTimestamp || !endTimestamp) {
    return response.status(400).json({ error: "missing required parameters: uid, startTimestamp, endTimestamp" });
  }

  const buckets = getBucketsInRange(startTimestamp, endTimestamp);
  console.log(buckets);

  let logss = [];
  getUserLogsRecursive(uid, buckets, logss, response, startTimestamp, endTimestamp);
});

exports.getLogsForUserInDaterange30days = onRequest(async(request, response) => {
  console.log(request.body);

  

  const end = new Date();
  const start = new Date(end);
  start.setDate(start.getDate()-30);

  const startTimestamp = start.getTime();
  const endTimestamp = end.getTime();
  

  const buckets = getBucketsInRange(startTimestamp, endTimestamp);
  console.log(buckets);

  
  let logss = [];
  logss = await getUserLogsRecursive30day(buckets, logss, startTimestamp, endTimestamp);

  const userNum = new Set(logss.map((log) => log.uid));
  console.log("unique users: ",userNum.size);


  const userPlat = {};
  logss.forEach(log => {
    const platform = (log.appDetails?.platform);
    if(!userPlat[platform]){
      userPlat[platform] = new Set();
    }
    userPlat[platform].add(log.uid);

  });

  const userPlatCount = Object.fromEntries(
  Object.entries(userPlat).map(([platform, usersSet]) => [platform, usersSet.size])
  );

  Object.entries(userPlatCount)
    .forEach(([platform, count]) => {
      console.log(`${platform}: ${count}`);
  });


  const userVer= {};
  logss.forEach(log => {
    const version = (log.appDetails?.appVersion).split(" ")[0].trim();
    if(!userVer[version]){
      userVer[version] = new Set();
    }
    userVer[version].add(log.uid);

  });

  const userVerCount = Object.fromEntries(
  Object.entries(userVer).map(([version, usersSet]) => [version, usersSet.size])
  );

  Object.entries(userVerCount)
    .forEach(([version, count]) => {
      console.log(`${version}: ${count}`);
    });

  response.status(200).json({
    uniqueUserCount: userNum.size,
    totalLogs: logss.length,
  });
});
